{
    "name": "hexlet/code",
    "type": "prooject",
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "Database\\Factories\\": "database/factories/",
            "Database\\Seeders\\": "database/seeders/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "authors": [
        {
            "name": "Alexandr Konishchev"
        }
    ],
    "require-dev": {
        "phpstan/phpstan": "^2.1",
        "laravel/pail": "^1.2",
        "nunomaduro/collision": "^8.8",
        "laravel/sail": "^1.46",
        "laravel/tinker": "^2.10",
        "phpunit/phpunit": "^12.4",
        "squizlabs/php_codesniffer": "*",
        "laravel/breeze": "^2.3",
        "fakerphp/faker": "^1.24",
        "mockery/mockery": "^1.6"
    },
    "require": {
        "laravel/framework": "^12.0",
        "sentry/sentry-laravel": "^4.16",
        "laracasts/flash": "^3.2",
        "spatie/laravel-html": "^3.13"
    }
}
